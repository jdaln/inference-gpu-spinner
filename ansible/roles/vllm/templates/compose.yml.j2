# Rendered by Ansible — do not edit on the host (changes are overwritten on next spin-up).
# Single ephemeral node: vLLM (OpenAI-compatible) behind Caddy (auto-TLS).
services:
{% if not (multi_model_enabled | default(false) | bool) %}
  vllm:
    # Profiles may pin their own image (vllm_image_override) when a checkpoint needs a build the
    # shared pin does not carry yet; everything else uses the validated global pin.
    image: {{ vllm_image_override | default(vllm_image) }}
    restart: unless-stopped
    ipc: host                       # required by vLLM (shared memory); avoids cryptic CUDA errors
{% if (cap_add | default([])) | length > 0 %}
    # Extra Linux capabilities this profile needs. Docker's default seccomp profile does not simply
    # allow-list syscalls — it gates some behind a matching capability, and denies them with EPERM
    # otherwise. Measured 2026-09-20: qwen38-flash-next sets VLLM_PLE_CPU_OFFLOAD=1, whose offload
    # worker passes CUDA tensors between processes with CUDA IPC. That path calls pidfd_getfd(2),
    # which is gated behind CAP_SYS_PTRACE, so engine init died with
    #   RuntimeError: pidfd_getfd: Operation not permitted
    # in torch/multiprocessing/reductions.py -> rebuild_cuda_tensor. Granting the one capability is
    # far narrower than seccomp=unconfined or pid=host, which are the other ways round it.
    cap_add:
{% for c in cap_add %}
      - {{ c }}
{% endfor %}
{% endif %}
    command:
      # model as a positional arg (vllm serve deprecates --model)
      - "{{ model_repo }}"
      - "--served-model-name={{ served_name }}"
      - "--max-model-len={{ max_model_len }}"
      - "--gpu-memory-utilization={{ gpu_memory_utilization }}"
      - "--tensor-parallel-size={{ tensor_parallel_size }}"
      - "--dtype={{ dtype }}"
{% if enable_lora | default(false) %}
      - "--enable-lora"
      - "--max-lora-rank={{ max_lora_rank | default(16) }}"
      - "--max-loras={{ max_loras | default(4) }}"
{% if (lora_modules | default([])) | length > 0 %}
      - "--lora-modules"
{% for m in lora_modules %}
      - "{{ m.name }}={{ m.path }}"
{% endfor %}
{% endif %}
{% endif %}
{% for arg in extra_vllm_args | default([]) %}
      - '{{ arg }}'
{% endfor %}
    environment:
      - HF_HOME=/root/.cache/huggingface
      - PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
{% if (vllm_plugin_mounts | default([])) | length > 0 %}
      # Out-of-tree plugin overlays (roles/vllm/tasks/plugins.yml). vLLM loads vllm.general_plugins
      # entry points from PYTHONPATH in every process; each plugin stays inert unless the profile
      # also sets its own environment variable below.
      - PYTHONPATH={{ vllm_plugin_mounts | map('regex_replace', '^.*/', '/opt/vllm-plugins/') | join(':') }}
{% endif %}
{% for k, v in (extra_env | default({})).items() %}
      - {{ k }}={{ v }}
{% endfor %}
    # Secrets (VLLM_API_KEY, optional HF_TOKEN) load from the 0600 .env so they stay out of the
    # container command/argv and `docker inspect` Args. vLLM reads VLLM_API_KEY as the --api-key
    # fallback. This mirrors the llama-swap backends, which use --env-file with the same file.
    env_file:
      - "{{ compose_dir }}/.env"
    volumes:
      - {{ hf_cache_dir }}:/root/.cache/huggingface
{% for m in vllm_plugin_mounts | default([]) %}
      - {{ m }}:/opt/vllm-plugins/{{ m | basename }}:ro
{% endfor %}
    ports:
      - "127.0.0.1:{{ vllm_port }}:8000"   # never exposed publicly; Caddy fronts it
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health').status==200 else 1)"]
      interval: 30s
      timeout: 5s
      retries: 30
      start_period: 600s
{% endif %}

  caddy:
    image: {{ caddy_image }}
    restart: unless-stopped
    network_mode: host              # binds :80/:443 on the host; reaches vLLM on 127.0.0.1
    volumes:
      - {{ compose_dir }}/Caddyfile:/etc/caddy/Caddyfile:ro
      - {{ caddy_data_dir }}:/data  # persisted cert store — survives teardown, avoids re-issuing
{% if not (multi_model_enabled | default(false) | bool) %}
    depends_on:
      - vllm
{% endif %}

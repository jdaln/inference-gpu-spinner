# Rendered by Ansible. llama-swap starts/stops a vLLM docker backend per model on demand; one model
# in VRAM at a time (default). The vLLM API key is passed to each backend via --env-file (the 0600
# {{ compose_dir }}/.env, which sets VLLM_API_KEY), so it never appears in the backend's argv /
# `docker inspect`. Clients pick a model via the OpenAI "model" field; an idle backend is unloaded
# after `ttl` seconds.
healthCheckTimeout: 600
models:
{% for m in swap_models %}
{#- Shell-quote each vLLM arg (map('quote')) so JSON-ish args like --limit-mm-per-prompt '{"image":0}'
    survive shell/shlex tokenisation, then emit the whole cmd via to_json so embedded quotes stay
    valid YAML (a bare double-quoted scalar would break on the '"' in the JSON arg). ${PORT} is a
    llama-swap macro and is left literal for llama-swap to expand. #}
{% set _args = (m.args | default([]) | map('quote') | join(' ')) %}
{% set _cmd = "docker run --rm --name vllm-swap-" ~ m.name ~ " --network host --gpus all --ipc=host --env-file " ~ compose_dir ~ "/.env -v " ~ hf_cache_dir ~ ":/root/.cache/huggingface -e PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True -e HF_HOME=/root/.cache/huggingface " ~ vllm_image ~ " " ~ m.model_repo ~ " --host 127.0.0.1 --port ${PORT} --served-model-name " ~ m.name ~ " --max-model-len " ~ (m.max_model_len | string) ~ " --gpu-memory-utilization " ~ (m.gpu_memory_utilization | default(gpu_memory_utilization | default(0.90)) | string) ~ ((" " ~ _args) if (_args | length > 0) else "") %}
  {{ m.name | to_json }}:
    # --network host is REQUIRED on UpCloud: containers on the DEFAULT docker bridge have no working
    # DNS (they get the UpCloud resolvers in resolv.conf but can't reach them from the bridge), so
    # the HF config fetch dies with "OSError: Can't load the configuration of ..." after ~90s of
    # retries and the backend exits ("upstream command exited prematurely"). Compose services are
    # fine because a compose network uses Docker's EMBEDDED DNS via the host. Host networking (the
    # same pattern Caddy uses) fixes the raw docker run path — root-caused live on H100, 2026-07-04.
    # On host network there is no -p mapping: vLLM binds 127.0.0.1:${PORT} directly.
    # HF_HOME mirrors the compose service so the backend shares the mounted /data HF cache.
    cmd: {{ _cmd | to_json }}
    proxy: "http://127.0.0.1:${PORT}"
    cmdStop: {{ ("docker stop vllm-swap-" ~ m.name) | to_json }}
    ttl: {{ swap_idle_ttl }}
{% endfor %}

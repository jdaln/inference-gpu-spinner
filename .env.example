# Copy to .env (gitignored) and fill in. Load it before running bin/spin:
#   set -a; source .env; set +a

# UpCloud API token (starts with ucat_). Control Panel > People > API tokens.
# Treat as a secret; never commit. Tip: restrict it to your IP via allowed_ip_ranges.
UPCLOUD_TOKEN=

# Email for Let's Encrypt / ACME registration (used by Caddy).
ACME_EMAIL=

# API key clients must present to vLLM (Authorization: Bearer ...).
# Generate a strong value:  openssl rand -hex 32
VLLM_API_KEY=

# Optional: Hugging Face token, for gated/private model downloads.
HF_TOKEN=

# Optional: default model profile to serve (ansible/models/<name>.yml). `bin/spin up --model M`
# overrides this. Default when unset: qwen36 (Qwen3.6-27B-FP8, fits an L40S).
VLLM_MODEL=

# Optional auto power-off safety (defaults: ON, 21:00 Europe/Zurich). The box powers ITSELF off so
# a forgotten server stops billing GPU. Override here, or per-run via bin/spin
# --shutdown-at / --shutdown-tz / --no-shutdown.
#   AUTO_SHUTDOWN=false        # opt out entirely
#   AUTO_SHUTDOWN_AT=19:30     # HH:MM, 24h, in AUTO_SHUTDOWN_TZ
#   AUTO_SHUTDOWN_TZ=Europe/Zurich
AUTO_SHUTDOWN=
AUTO_SHUTDOWN_AT=
AUTO_SHUTDOWN_TZ=

# Optional: override the operator IP that the firewall allowlists for SSH/HTTPS.
# Leave empty to auto-detect the public IP of the machine running `bin/spin`.
OPERATOR_IP=

# Optional: comma-separated IPs/CIDRs to allowlist instead of a single IP (takes priority).
# Use this if your egress IP rotates — list the covering range(s). IPv4 only; bare IP = /32.
#   OPERATOR_CIDRS=198.51.100.0/24, 203.0.113.0/24
OPERATOR_CIDRS=

# Optional: persistent data-disk size + tier, used by `bin/spin persistent-init`. This disk holds the
# cached weights and bills 24/7 between sessions, so it IS your standing cost. On UpCloud MaxIOPS is
# ~€0.226/GB·month (500 GB ≈ €113/mo, 150 GB ≈ €34/mo); `standard` is ~€0.086/GB·month (cheaper, slower
# model loads). Size to what you actually cache. Defaults if unset: 150 GB, maxiops (bump to ~500 for GLM).
#   WEIGHTS_SIZE_GB=150
#   WEIGHTS_TIER=maxiops
WEIGHTS_SIZE_GB=
WEIGHTS_TIER=

# Refuse to deploy a plan costing more than this per hour. bin/spin reads the price of the resolved
# plan from tests/plans.txt and stops before anything is provisioned; `--allow-expensive` on a
# single run, or a higher value here, opts in. Unset means 10.
#   MAX_EUR_PER_HOUR=10
MAX_EUR_PER_HOUR=

# Auto-decommission the persistent disk on `bin/spin down` to stop its standing cost. By DEFAULT
# (auto), a disk >= DECOMMISSION_THRESHOLD_GB (default 150) is deleted on teardown — a visible warning
# is printed first, and the floating IP is KEPT (stable hostname; next `bin/spin up` recreates the disk
# + re-downloads weights + re-issues the cert). Set `never` (or run `bin/spin down --keep-disk`) to keep
# it warm for fast restarts; raise the threshold to protect smaller disks.
#   DECOMMISSION_ON_DOWN=never
#   DECOMMISSION_THRESHOLD_GB=150
DECOMMISSION_ON_DOWN=
DECOMMISSION_THRESHOLD_GB=

#!/usr/bin/env bash
# gpu-spinner operational CLI. See: bin/spin help
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PERSIST_DIR="terraform/persistent"
EPHEMERAL_DIR="terraform/providers/upcloud"
PREFETCH_DIR="terraform/prefetch"
INVENTORY="ansible/inventory/hosts.ini"
# Must match ansible's compose_dir (group_vars/all.yml); the compose project name (and thus
# container names like <project>-vllm-1) derives from this directory's basename.
COMPOSE_DIR="/opt/gpu-spinner"
VLLM_CONTAINER="gpu-spinner-vllm-1"
TOFU="${TOFU:-tofu}"
SSH_OPTS=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null)

# Load .env if present (UPCLOUD_TOKEN, ACME_EMAIL, VLLM_API_KEY, OPERATOR_IP, HF_TOKEN).
# .env is generated at runtime (gitignored), so shellcheck can't follow it.
# shellcheck source=/dev/null
if [ -f .env ]; then set -a; . ./.env; set +a; fi

# The command implementations live in bin/lib/*.sh, sourced here. Paths are spelled out so
# `shellcheck -x` follows them and checks the CLI as one unit.
# shellcheck source=bin/lib/common.sh
. "$ROOT/bin/lib/common.sh"
# shellcheck source=bin/lib/net.sh
. "$ROOT/bin/lib/net.sh"
# shellcheck source=bin/lib/plan.sh
. "$ROOT/bin/lib/plan.sh"
# shellcheck source=bin/lib/stack.sh
. "$ROOT/bin/lib/stack.sh"
# shellcheck source=bin/lib/checks.sh
. "$ROOT/bin/lib/checks.sh"

# Everything below leans on these; fail fast with a clear message instead of mid-command.
for _dep in curl jq "$TOFU" ansible-playbook ssh; do
  command -v "$_dep" >/dev/null 2>&1 || die "required tool '$_dep' not found in PATH."
done

usage() {
  cat <<'EOF'
inference-gpu-spinner — on-demand Cloud GPU + vLLM

Usage: bin/spin <command> [options]

  persistent-init        Create/resize the long-lived disk + floating IP (size via WEIGHTS_SIZE_GB).
  persistent-destroy --yes  Decommission the disk + floating IP (→ €0 standing). IRREVERSIBLE:
                         loses cached weights + the stable IP/cert. Requires --yes.
  up [--model M] [--plan P] [--swap-profile NAME] [--shutdown-at HH:MM] [--shutdown-tz TZ] [--no-shutdown]
                         Provision the GPU server, then deploy vLLM via Ansible.
                         --plan is OPTIONAL: without it, the tier comes from the profile's min_plan
                         (or the preset's swap_plan), so each model lands on the plan it is meant
                         for. Pass --plan to override. On an existing server the live plan wins, and
                         a mismatch with the profile's is an error rather than a silent resize.
                         --swap-profile NAME serves several models on one box via llama-swap (one in
                         VRAM at a time); presets live in ansible/swap-profiles/ (see swap-profiles).
                         --allow-expensive deploys a plan above MAX_EUR_PER_HOUR (default 10).
                         --allow-unvalidated overrides the HARDWARE preflights (VRAM, compute
                         capability, known-bad GPU list, driver, disk). It is not a cost flag.
                         -e k=v passes an Ansible extra-var through (repeatable). Extra vars beat
                         the profile, so this deploys the same model at a different setting without
                         editing it: -e max_model_len=262144, -e vllm_image_override=<tag>.
                         Safety: auto power-off defaults ON at 21:00 Europe/Zurich (UpCloud only,
                         where a stopped server isn't billed). --no-shutdown opts out.
  down [--keep-disk]     Destroy the GPU server (the cost saver). By DEFAULT it also decommissions a
                         large persistent disk (>= DECOMMISSION_THRESHOLD_GB, default 150) to stop its
                         standing cost, keeping the floating IP. --keep-disk (or
                         DECOMMISSION_ON_DOWN=never) keeps the disk warm for fast restarts.
  start                  Resume a STOPPED server (e.g. after the auto-off safety) — fast, no rebuild.
  stop                   Power the server OFF now (manual auto-off; stops GPU billing, keeps disk+IP).
  status                 Show tofu outputs + remote GPU/service status.
  logs                   Tail vLLM/Caddy logs over SSH.
  ssh [args...]          SSH into the GPU box.
  plan                   tofu plan for the ephemeral stack.
  swap-profiles          List the multi-model swap presets (ansible/swap-profiles/).
  prefetch <profile>...  Download those profiles' weights AND container images onto the persistent
                         disk using a cheap CPU box (~EUR 0.045/h), then destroy it. A download is
                         billed at whatever compute holds the disk and is not GPU work: ~354 GB
                         costs ~EUR 5 on 4x RTX PRO 6000 and ~EUR 0.04 here. Run it before
                         `up` so the GPU box starts warm. Requires no GPU server to exist (a disk
                         attaches to one server at a time).
  validate               Capture exact validation evidence (context/KV/VRAM/test gen) for docs/validation.md.
  soak [--rounds N] [--concurrency M] [--context T] [--model NAME]
                         Answer-quality soak: temp-0 factual battery, fabrication traps, then a
                         graded long-context load — each of M parallel requests gets its own
                         ~T-token haystack with a unique needle at a known depth and is graded on
                         retrieving it. Default 3 rounds x 20 parallel x 32768 tokens. A wrong
                         answer from an admitted request fails the command; rejections and timeouts
                         are reported but do not (admission control, not correctness). T is clamped
                         to the model's max_model_len. Prompts cross the public endpoint: ~2.5 MB
                         per round at 32768, ~10 MB at 131072.
  ceiling [--model NAME] [--start N] [--max N] [--step K] [--keep-going]
                         Find the longest SINGLE request the deployed model survives, so
                         max_model_len comes from a measurement rather than the recipe. Probes one
                         request at a time, ascending (a crash costs a full engine reload, so
                         bisecting is the expensive way), and judges each result on the container's
                         restart counter — a crashed engine is restarted by compose and `soak`
                         would file it as a mere rejection. Nothing can exceed the DEPLOYED
                         max_model_len, so redeploy high first:
                           bin/spin up --model M --plan <plan in state> -e max_model_len=<native>
                         Report the pass/fail boundary in prompt_tokens, never the requested value.
  help                   This message.

Env (see .env.example): UPCLOUD_TOKEN, ACME_EMAIL, VLLM_API_KEY, [OPERATOR_IP|OPERATOR_CIDRS],
  [MAX_EUR_PER_HOUR=10]   (refuse a costlier plan unless --allow-expensive; prices from tests/plans.txt)
  [WEIGHTS_DISK=primary|alt]   (alt = the optional second data disk; see terraform/persistent)
  [HF_TOKEN], [AUTO_SHUTDOWN=true|false], [AUTO_SHUTDOWN_AT=HH:MM], [AUTO_SHUTDOWN_TZ=Area/City],
  [WEIGHTS_SIZE_GB=NNN], [WEIGHTS_TIER=maxiops|standard]   (persistent disk size/tier = standing cost)
  [DECOMMISSION_ON_DOWN=auto|never], [DECOMMISSION_THRESHOLD_GB=NNN]   (auto-free a big disk on down)
EOF
}

case "${1:-help}" in
  persistent-init) shift; cmd_persistent_init "$@" ;;
  persistent-destroy) shift; cmd_persistent_destroy "$@" ;;
  up)              shift; cmd_up "$@" ;;
  down)            shift; cmd_down "$@" ;;
  start)           shift; cmd_start "$@" ;;
  stop)            shift; cmd_stop "$@" ;;
  status)          shift; cmd_status "$@" ;;
  logs)            shift; cmd_logs "$@" ;;
  ssh)             shift; cmd_ssh "$@" ;;
  plan)            shift; cmd_plan "$@" ;;
  prefetch)        shift; cmd_prefetch "$@" ;;
  swap-profiles)   shift; cmd_swap_profiles "$@" ;;
  validate)        shift; cmd_validate "$@" ;;
  soak)            shift; cmd_soak "$@" ;;
  ceiling)         shift; cmd_ceiling "$@" ;;
  help|-h|--help)  usage ;;
  *) usage; exit 1 ;;
esac
